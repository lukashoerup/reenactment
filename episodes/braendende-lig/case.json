{
 "episode": "Danske Drabssager S6E5 — Det Brændende Lig",
 "note": "Single source of truth for facts shown on screen. Every fact cites the episode time it is said at. Places marked approx are deliberately vague: the episode says only 'a forest near Køge'.",
 "facts": {
  "when": {
   "text": "September 1999, regnvejr",
   "said": "04:05"
  },
  "found_by": {
   "text": "To børn, der legede i regnvejr, så et bål med høje flammer",
   "said": "02:59"
  },
  "police": {
   "text": "Køge Politi rykker ud og tilkalder Rigspolitiets Rejsehold",
   "said": "03:15-03:41"
  },
  "pathologist": {
   "text": "Retsmediciner Hans Petter Hougen kaldes ud til bålet",
   "said": "05:33"
  },
  "bundle": {
   "text": "En bylt på cirka 70 centimeter, delvis brændt stof og tæpper",
   "said": "01:48, 05:43-05:55"
  },
  "no_soot": {
   "text": "Ingen sod i luftvejene: hun var død, da hun blev lagt på bålet",
   "said": "11:06-11:16"
  },
  "blunt": {
   "text": "Flere kraniebrud, slag med et tungt instrument (stump vold)",
   "said": "10:44, 11:30-11:58"
  },
  "young": {
   "text": "En yngre kvinde",
   "said": "12:08-12:20"
  },
  "missing": {
   "text": "Ingen savnet i Køge Politikreds eller i hele landet",
   "said": "12:44"
  },
  "bottle": {
   "text": "En flaske tændvæske; brandprøver og flasken til analyse på Dansk Teknologisk Institut",
   "said": "15:15-15:34"
  },
  "tyres": {
   "text": "Dækaftryk i den våde skovbund, fotograferet med målestok og støbt i gips",
   "said": "15:44-16:04"
  },
  "car": {
   "text": "Dækkene kunne være fra en VW Golf eller Polo; vidner så en Polo eller Golf køre fra stedet",
   "said": "16:18-16:36"
  },
  "verdict": {
   "text": "Gerningsmanden var skizofren, blev dømt og var mange år på Sct. Hans; senere behandlingsdom",
   "said": "36:42-36:51"
  },
  "headline": {
   "text": "Hvem kender brandkvinden? Ekstra Bladet, 30. september 1999",
   "said": "02:21-02:23"
  }
